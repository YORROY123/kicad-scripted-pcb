(version 1)
(rule "pads within one footprint"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
  (constraint clearance (min 0.1mm)))
(rule "diff pair PCIe REFCLK"
  (condition "(A.NetName == 'PCIE_CLK_P' && B.NetName == 'PCIE_CLK_N') || (A.NetName == 'PCIE_CLK_N' && B.NetName == 'PCIE_CLK_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair PCIe TX"
  (condition "(A.NetName == 'PCIE_TX_P' && B.NetName == 'PCIE_TX_N') || (A.NetName == 'PCIE_TX_N' && B.NetName == 'PCIE_TX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair PCIe RX"
  (condition "(A.NetName == 'PCIE_RX_P' && B.NetName == 'PCIE_RX_N') || (A.NetName == 'PCIE_RX_N' && B.NetName == 'PCIE_RX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-0 RX(CM5 端)"
  (condition "(A.NetName == 'CM5U0_RX_P' && B.NetName == 'CM5U0_RX_N') || (A.NetName == 'CM5U0_RX_N' && B.NetName == 'CM5U0_RX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-0 TX(LAN7800 端)"
  (condition "(A.NetName == 'LAN0_TX_P' && B.NetName == 'LAN0_TX_N') || (A.NetName == 'LAN0_TX_N' && B.NetName == 'LAN0_TX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-0 RX(LAN7800 端)"
  (condition "(A.NetName == 'LAN0_RX_P' && B.NetName == 'LAN0_RX_N') || (A.NetName == 'LAN0_RX_N' && B.NetName == 'LAN0_RX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 LAN0"
  (condition "(A.NetName == 'LAN0_DP' && B.NetName == 'LAN0_DM') || (A.NetName == 'LAN0_DM' && B.NetName == 'LAN0_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-1 RX(CM5 端)"
  (condition "(A.NetName == 'CM5U1_RX_P' && B.NetName == 'CM5U1_RX_N') || (A.NetName == 'CM5U1_RX_N' && B.NetName == 'CM5U1_RX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-1 TX(LAN7800 端)"
  (condition "(A.NetName == 'LAN1_TX_P' && B.NetName == 'LAN1_TX_N') || (A.NetName == 'LAN1_TX_N' && B.NetName == 'LAN1_TX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB3-1 RX(LAN7800 端)"
  (condition "(A.NetName == 'LAN1_RX_P' && B.NetName == 'LAN1_RX_N') || (A.NetName == 'LAN1_RX_N' && B.NetName == 'LAN1_RX_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 LAN1"
  (condition "(A.NetName == 'LAN1_DP' && B.NetName == 'LAN1_DM') || (A.NetName == 'LAN1_DM' && B.NetName == 'LAN1_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 CM5"
  (condition "(A.NetName == 'CM5_USB_P' && B.NetName == 'CM5_USB_N') || (A.NetName == 'CM5_USB_N' && B.NetName == 'CM5_USB_P')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 Hub 上行"
  (condition "(A.NetName == 'HUB_UP_DP' && B.NetName == 'HUB_UP_DN') || (A.NetName == 'HUB_UP_DN' && B.NetName == 'HUB_UP_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 USB-C"
  (condition "(A.NetName == 'USBC_DP' && B.NetName == 'USBC_DN') || (A.NetName == 'USBC_DN' && B.NetName == 'USBC_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 USB-A 0"
  (condition "(A.NetName == 'USBA0_DP' && B.NetName == 'USBA0_DN') || (A.NetName == 'USBA0_DN' && B.NetName == 'USBA0_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair USB2 USB-A 1"
  (condition "(A.NetName == 'USBA1_DP' && B.NetName == 'USBA1_DN') || (A.NetName == 'USBA1_DN' && B.NetName == 'USBA1_DP')")
  (constraint clearance (min 0.14mm)))
(rule "diff pair 乙太網路 0"
  (condition "(A.NetName == 'ETH0_P' && B.NetName == 'ETH0_N') || (A.NetName == 'ETH0_N' && B.NetName == 'ETH0_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair 乙太網路 0 width"
  (condition "A.NetName == 'ETH0_P' || A.NetName == 'ETH0_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair 乙太網路 1"
  (condition "(A.NetName == 'ETH1_P' && B.NetName == 'ETH1_N') || (A.NetName == 'ETH1_N' && B.NetName == 'ETH1_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair 乙太網路 1 width"
  (condition "A.NetName == 'ETH1_P' || A.NetName == 'ETH1_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair 乙太網路 3"
  (condition "(A.NetName == 'ETH3_P' && B.NetName == 'ETH3_N') || (A.NetName == 'ETH3_N' && B.NetName == 'ETH3_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair 乙太網路 3 width"
  (condition "A.NetName == 'ETH3_P' || A.NetName == 'ETH3_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair 乙太網路 2"
  (condition "(A.NetName == 'ETH2_P' && B.NetName == 'ETH2_N') || (A.NetName == 'ETH2_N' && B.NetName == 'ETH2_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair 乙太網路 2 width"
  (condition "A.NetName == 'ETH2_P' || A.NetName == 'ETH2_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair HDMI0 D2"
  (condition "(A.NetName == 'HDMI0_D2_P' && B.NetName == 'HDMI0_D2_N') || (A.NetName == 'HDMI0_D2_N' && B.NetName == 'HDMI0_D2_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair HDMI0 D2 width"
  (condition "A.NetName == 'HDMI0_D2_P' || A.NetName == 'HDMI0_D2_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair HDMI0 D1"
  (condition "(A.NetName == 'HDMI0_D1_P' && B.NetName == 'HDMI0_D1_N') || (A.NetName == 'HDMI0_D1_N' && B.NetName == 'HDMI0_D1_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair HDMI0 D1 width"
  (condition "A.NetName == 'HDMI0_D1_P' || A.NetName == 'HDMI0_D1_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair HDMI0 D0"
  (condition "(A.NetName == 'HDMI0_D0_P' && B.NetName == 'HDMI0_D0_N') || (A.NetName == 'HDMI0_D0_N' && B.NetName == 'HDMI0_D0_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair HDMI0 D0 width"
  (condition "A.NetName == 'HDMI0_D0_P' || A.NetName == 'HDMI0_D0_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair HDMI0 CK"
  (condition "(A.NetName == 'HDMI0_CK_P' && B.NetName == 'HDMI0_CK_N') || (A.NetName == 'HDMI0_CK_N' && B.NetName == 'HDMI0_CK_P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair HDMI0 CK width"
  (condition "A.NetName == 'HDMI0_CK_P' || A.NetName == 'HDMI0_CK_N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN0 MDI TR0"
  (condition "(A.NetName == 'LAN0_TR0P' && B.NetName == 'LAN0_TR0N') || (A.NetName == 'LAN0_TR0N' && B.NetName == 'LAN0_TR0P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN0 MDI TR0 width"
  (condition "A.NetName == 'LAN0_TR0P' || A.NetName == 'LAN0_TR0N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN0 MDI TR1"
  (condition "(A.NetName == 'LAN0_TR1P' && B.NetName == 'LAN0_TR1N') || (A.NetName == 'LAN0_TR1N' && B.NetName == 'LAN0_TR1P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN0 MDI TR1 width"
  (condition "A.NetName == 'LAN0_TR1P' || A.NetName == 'LAN0_TR1N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN0 MDI TR2"
  (condition "(A.NetName == 'LAN0_TR2P' && B.NetName == 'LAN0_TR2N') || (A.NetName == 'LAN0_TR2N' && B.NetName == 'LAN0_TR2P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN0 MDI TR2 width"
  (condition "A.NetName == 'LAN0_TR2P' || A.NetName == 'LAN0_TR2N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN0 MDI TR3"
  (condition "(A.NetName == 'LAN0_TR3P' && B.NetName == 'LAN0_TR3N') || (A.NetName == 'LAN0_TR3N' && B.NetName == 'LAN0_TR3P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN0 MDI TR3 width"
  (condition "A.NetName == 'LAN0_TR3P' || A.NetName == 'LAN0_TR3N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN1 MDI TR0"
  (condition "(A.NetName == 'LAN1_TR0P' && B.NetName == 'LAN1_TR0N') || (A.NetName == 'LAN1_TR0N' && B.NetName == 'LAN1_TR0P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN1 MDI TR0 width"
  (condition "A.NetName == 'LAN1_TR0P' || A.NetName == 'LAN1_TR0N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN1 MDI TR1"
  (condition "(A.NetName == 'LAN1_TR1P' && B.NetName == 'LAN1_TR1N') || (A.NetName == 'LAN1_TR1N' && B.NetName == 'LAN1_TR1P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN1 MDI TR1 width"
  (condition "A.NetName == 'LAN1_TR1P' || A.NetName == 'LAN1_TR1N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN1 MDI TR2"
  (condition "(A.NetName == 'LAN1_TR2P' && B.NetName == 'LAN1_TR2N') || (A.NetName == 'LAN1_TR2N' && B.NetName == 'LAN1_TR2P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN1 MDI TR2 width"
  (condition "A.NetName == 'LAN1_TR2P' || A.NetName == 'LAN1_TR2N'")
  (constraint track_width (min 0.145mm)))
(rule "diff pair LAN1 MDI TR3"
  (condition "(A.NetName == 'LAN1_TR3P' && B.NetName == 'LAN1_TR3N') || (A.NetName == 'LAN1_TR3N' && B.NetName == 'LAN1_TR3P')")
  (constraint clearance (min 0.19mm)))
(rule "diff pair LAN1 MDI TR3 width"
  (condition "A.NetName == 'LAN1_TR3P' || A.NetName == 'LAN1_TR3N'")
  (constraint track_width (min 0.145mm)))
